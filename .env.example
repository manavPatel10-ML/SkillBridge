# ============================================================
# SkillBridge Environment Variables
# ============================================================
# Copy this file to .env.local for development.
# For production (Vercel), set all SERVER-ONLY and SECRET
# variables in the Vercel Dashboard -> Settings -> Environment Variables.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ---- Firebase Client SDK (PUBLIC - safe to expose) --------
# These are read by the browser. Found in Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (SERVER-ONLY - NEVER use NEXT_PUBLIC_) ----
# FIREBASE_SERVICE_ACCOUNT_KEY: Full JSON string of service account key.
# Generate in Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key. Paste the entire JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=

# ---- Application Environment --------------------------------
# Set to 'production' in Vercel. Do NOT set to 'development' or 'test' in prod.
# Accepted values: development | beta | test | production
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development

# ---- Firebase Emulator (DEVELOPMENT ONLY) -------------------
# Set to 'true' ONLY for local development with emulators.
# MUST be absent or 'false' in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ---- Code Execution (Piston) --------------------------------
# Optional: Override the public Piston API endpoint.
# Defaults to https://emkc.org/api/v2/piston (public, no auth required).
# Set this in production if you run a self-hosted Piston instance.
PISTON_API_URL=

# ---- Cron Job Protection ------------------------------------
# A random secret string used to authenticate internal cron calls.
# Generate with: openssl rand -hex 32
# Call /api/cron/abandonment with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---- Billing / Stripe (NOT YET LIVE) -------------------------
# Leave empty until a real Stripe account is connected.
# When Stripe is live, set these to real values from Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Internal Admin Billing Key (BETA_MANAGED MODE) ---------
# Used only in Beta Managed mode when Stripe is not configured.
# Generate with: openssl rand -hex 32
ADMIN_BILLING_KEY=
